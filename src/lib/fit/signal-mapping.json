{
  "version": "fit-v1",
  "notes": [
    "Rule classifier table (spec Appendix B). Each rule fires when its `when` clause matches a normalized item and adds the probabilities in `assign` to the item's axis vectors; multiple rules combine per category by noisy-OR: p = 1 - Π(1 - p_i).",
    "MeSH signals are keyed by descriptor NAME. The loader (src/lib/fit/classify/mesh.ts) resolves names to descriptor UIs and tree numbers from the mesh_descriptors table and must FAIL LOUDLY if a name does not resolve. `ui_hint` values are for cross-checking only — verify them against the MeSH descriptor file, do not trust them blindly.",
    "`mesh_tree_under` matches any descriptor whose tree number starts with the prefix (children included). `pubtype` matches PublicationTypeList entries. `check_tag` matches the MeSH check tags (Humans, Animals, Mice…).",
    "`not` clauses are hard negatives: the rule does not fire if any listed signal is present.",
    "Values are priors; recalibrate against fit_labels (spec §12, §14)."
  ],

  "rules": [
    { "id": "pt_rct", "source": "pubmed", "when": { "pubtype": ["Randomized Controlled Trial"] }, "ui_hint": "D016449",
      "assign": { "paradigm": { "clinical_trials": 0.95 }, "unit": { "L3": 0.9 }, "design": { "rct": 0.95 }, "materials": { "enrolled_participants": 0.9 } } },
    { "id": "pt_phase1", "source": "pubmed", "when": { "pubtype": ["Clinical Trial, Phase I"] }, "ui_hint": "D017426",
      "assign": { "paradigm": { "clinical_trials": 0.9, "early_phase_human_experimental": 0.7 }, "unit": { "L3": 0.9 }, "design": { "early_phase_trial": 0.9 }, "materials": { "enrolled_participants": 0.9 } } },
    { "id": "pt_phase2_4", "source": "pubmed", "when": { "pubtype_any": ["Clinical Trial, Phase II", "Clinical Trial, Phase III", "Clinical Trial, Phase IV"] }, "ui_hint": "D017427/D017428/D017429",
      "assign": { "paradigm": { "clinical_trials": 0.9 }, "unit": { "L3": 0.9 }, "design": { "rct": 0.85 }, "materials": { "enrolled_participants": 0.9 } } },
    { "id": "pt_pragmatic", "source": "pubmed", "when": { "pubtype": ["Pragmatic Clinical Trial"] }, "ui_hint": "D065007",
      "assign": { "paradigm": { "clinical_trials": 0.8, "health_services": 0.5, "implementation_science": 0.4 }, "unit": { "L3": 0.6, "L5": 0.5 }, "design": { "pragmatic_trial": 0.95 }, "materials": { "patients_under_care": 0.8 } } },
    { "id": "pt_clinical_trial_generic", "source": "pubmed", "when": { "pubtype": ["Clinical Trial"], "not": { "pubtype_any": ["Randomized Controlled Trial", "Clinical Trial, Phase I", "Clinical Trial, Phase II", "Clinical Trial, Phase III", "Clinical Trial, Phase IV"] } }, "ui_hint": "D016430",
      "assign": { "paradigm": { "clinical_trials": 0.7, "interventional_clinical": 0.5 }, "unit": { "L3": 0.8 }, "design": { "single_arm_interventional": 0.7 }, "materials": { "enrolled_participants": 0.8 } } },
    { "id": "pt_observational_prospective", "source": "pubmed", "when": { "pubtype": ["Observational Study"], "mesh_any": ["Prospective Studies"], "check_tag": ["Humans"] }, "ui_hint": "D064888 + D011446",
      "assign": { "paradigm": { "clinical_observational": 0.7, "epidemiology": 0.5 }, "unit": { "L3": 0.6, "L4": 0.5 }, "design": { "prospective_cohort": 0.9 }, "materials": { "enrolled_participants": 0.7 } } },
    { "id": "pt_observational_generic", "source": "pubmed", "when": { "pubtype": ["Observational Study"], "not": { "mesh_any": ["Prospective Studies"] } },
      "assign": { "paradigm": { "clinical_observational": 0.6, "epidemiology": 0.5 }, "unit": { "L3": 0.5, "L4": 0.5 }, "design": { "retrospective_cohort": 0.6 } } },
    { "id": "pt_meta_analysis", "source": "pubmed", "when": { "pubtype_any": ["Meta-Analysis", "Systematic Review"] }, "ui_hint": "D017418",
      "assign": { "paradigm": { "comparative_effectiveness": 0.4, "epidemiology": 0.3 }, "unit": { "L4": 0.6 }, "design": { "secondary_data_analysis": 0.8 }, "materials": { "published_literature": 0.95 } } },

    { "id": "mesh_cohort_epi", "source": "pubmed", "when": { "mesh_any": ["Cohort Studies"], "mesh_any_2": ["Risk Factors", "Incidence", "Prevalence", "Epidemiologic Studies"], "check_tag": ["Humans"] }, "ui_hint": "D015331 · D012307 · D015994 · D015995 · D016015",
      "assign": { "paradigm": { "epidemiology": 0.85 }, "unit": { "L4": 0.85 }, "design": { "prospective_cohort": 0.6, "retrospective_cohort": 0.6 }, "materials": { "cohort_biobank_datasets": 0.8 } } },
    { "id": "mesh_case_control", "source": "pubmed", "when": { "mesh_any": ["Case-Control Studies"] }, "ui_hint": "D016022",
      "assign": { "paradigm": { "epidemiology": 0.8, "clinical_observational": 0.4 }, "unit": { "L4": 0.8 }, "design": { "case_control": 0.95 } } },
    { "id": "mesh_cross_sectional", "source": "pubmed", "when": { "mesh_any": ["Cross-Sectional Studies"] }, "ui_hint": "D003430",
      "assign": { "paradigm": { "epidemiology": 0.75, "clinical_observational": 0.4 }, "unit": { "L4": 0.8 }, "design": { "cross_sectional": 0.95 } } },
    { "id": "mesh_retrospective", "source": "pubmed", "when": { "mesh_any": ["Retrospective Studies"], "check_tag": ["Humans"] }, "ui_hint": "D012189",
      "assign": { "paradigm": { "clinical_observational": 0.6, "epidemiology": 0.4 }, "unit": { "L3": 0.5, "L4": 0.5 }, "design": { "retrospective_cohort": 0.85 } } },
    { "id": "mesh_registries", "source": "pubmed", "when": { "mesh_any": ["Registries"] }, "ui_hint": "D012042",
      "assign": { "paradigm": { "epidemiology": 0.6, "outcomes_research": 0.4 }, "unit": { "L4": 0.85 }, "design": { "registry": 0.95 }, "materials": { "registries_surveillance": 0.9 } } },
    { "id": "mesh_gwas", "source": "pubmed", "when": { "mesh_any": ["Genome-Wide Association Study", "Polymorphism, Single Nucleotide", "Mendelian Randomization Analysis"] }, "ui_hint": "D055106 · D020641 · D057182",
      "assign": { "paradigm": { "genetic_epidemiology": 0.9 }, "unit": { "L4": 0.8, "L1": 0.4 }, "design": { "gwas": 0.95, "causal_inference": 0.5 }, "materials": { "genomic_datasets": 0.9, "cohort_biobank_datasets": 0.6 } } },
    { "id": "mesh_rwd", "source": "pubmed", "when": { "mesh_any": ["Electronic Health Records", "Insurance Claim Review", "Medicare", "Medicaid", "Databases, Factual", "Medical Record Linkage"] }, "ui_hint": "D057286 · D007344 · D008590 · D016208",
      "assign": { "paradigm": { "health_services": 0.7, "epidemiology": 0.5, "outcomes_research": 0.5 }, "unit": { "L4": 0.8, "L5": 0.5 }, "design": { "ehr_analysis": 0.8, "claims_analysis": 0.6 }, "materials": { "ehr": 0.8, "claims_administrative": 0.6 } } },
    { "id": "mesh_hsr", "source": "pubmed", "when": { "mesh_any": ["Health Services Research", "Health Services Accessibility", "Delivery of Health Care", "Quality of Health Care", "Health Care Costs"] }, "ui_hint": "D006302 · D006297 · D003695 · D011787",
      "assign": { "paradigm": { "health_services": 0.9, "outcomes_research": 0.6 }, "unit": { "L5": 0.8 } } },
    { "id": "mesh_outcomes", "source": "pubmed", "when": { "mesh_any": ["Outcome Assessment, Health Care", "Patient Reported Outcome Measures"] }, "ui_hint": "D017063 · D000071066",
      "assign": { "paradigm": { "outcomes_research": 0.85 }, "unit": { "L3": 0.5, "L4": 0.6 } } },
    { "id": "mesh_cer", "source": "pubmed", "when": { "mesh_any": ["Comparative Effectiveness Research"] }, "ui_hint": "D057170",
      "assign": { "paradigm": { "comparative_effectiveness": 0.95 }, "unit": { "L3": 0.5, "L4": 0.6 } } },
    { "id": "mesh_implementation", "source": "pubmed", "when": { "mesh_any": ["Implementation Science", "Diffusion of Innovation"] }, "ui_hint": "D000078329 · D005998",
      "assign": { "paradigm": { "implementation_science": 0.95 }, "unit": { "L5": 0.8 }, "design": { "implementation_evaluation": 0.8, "hybrid_effectiveness_implementation": 0.5 } } },
    { "id": "mesh_cbpr", "source": "pubmed", "when": { "mesh_any": ["Community-Based Participatory Research"] }, "ui_hint": "D055720",
      "assign": { "paradigm": { "community_based": 0.95 }, "unit": { "L4": 0.9 }, "design": { "community_engaged": 0.95 } } },
    { "id": "mesh_sdoh", "source": "pubmed", "when": { "mesh_any": ["Social Determinants of Health", "Health Status Disparities", "Socioeconomic Factors", "Healthcare Disparities"] }, "ui_hint": "D064890 · D054624 · D012959",
      "assign": { "paradigm": { "population_health": 0.85 }, "unit": { "L4": 0.85 } } },
    { "id": "mesh_public_health", "source": "pubmed", "when": { "mesh_any": ["Population Surveillance", "Public Health Practice", "Health Policy"] }, "ui_hint": "D011159 · D006291",
      "assign": { "paradigm": { "public_health": 0.85 }, "unit": { "L4": 0.6, "L5": 0.6 }, "materials": { "registries_surveillance": 0.6 } } },
    { "id": "mesh_qual_survey", "source": "pubmed", "when": { "mesh_any": ["Qualitative Research", "Interviews as Topic", "Focus Groups", "Surveys and Questionnaires"] }, "ui_hint": "D036301 · D033242 · D017144 · D011795",
      "assign": { "paradigm": { "behavioral": 0.4, "health_services": 0.3 }, "unit": { "L3": 0.5, "L4": 0.5 }, "design": { "qualitative": 0.6, "survey": 0.6 }, "materials": { "surveys": 0.7 } } },
    { "id": "mesh_behavioral", "source": "pubmed", "when": { "mesh_any": ["Health Behavior", "Behavior Therapy", "Motivational Interviewing", "Health Promotion"] }, "ui_hint": "D015438 · D001521",
      "assign": { "paradigm": { "behavioral": 0.85 }, "unit": { "L3": 0.6 } } },
    { "id": "mesh_computational", "source": "pubmed", "when": { "mesh_any": ["Machine Learning", "Computational Biology", "Models, Statistical", "Deep Learning", "Artificial Intelligence"] }, "ui_hint": "D000069550 · D019295 · D015233",
      "assign": { "paradigm": { "computational_data_science": 0.8 }, "design": { "ml_model_development": 0.6, "statistical_epi_modeling": 0.4 } } },
    { "id": "mesh_bioinformatics", "source": "pubmed", "when": { "mesh_any": ["Computational Biology"], "mesh_any_2": ["Genomics", "Sequence Analysis", "Transcriptome", "Proteomics"], "not": { "mesh_any": ["Cells, Cultured", "Cell Line", "Disease Models, Animal"] } },
      "assign": { "paradigm": { "bioinformatics": 0.8 }, "unit": { "L1": 0.6 }, "design": { "secondary_data_analysis": 0.7 }, "materials": { "genomic_datasets": 0.7 } } },

    { "id": "tag_animals_only", "source": "pubmed", "when": { "check_tag_any": ["Animals", "Mice", "Rats", "Zebrafish", "Primates", "Macaca"], "not": { "check_tag": ["Humans"] } }, "ui_hint": "D000818 · D051379 · D051381",
      "assign": { "paradigm": { "animal_model": 0.8, "molecular_cellular_mechanistic": 0.5 }, "unit": { "L2": 0.8, "L1": 0.5 }, "design": { "animal_in_vivo": 0.8 }, "materials": { "animal_mouse": 0.7 } } },
    { "id": "mesh_disease_models_animal", "source": "pubmed", "when": { "mesh_any": ["Disease Models, Animal", "Mice, Knockout", "Mice, Transgenic", "Xenograft Model Antitumor Assays", "Mice, Inbred C57BL"] }, "ui_hint": "D004195 · D018345 · D008822 · D023041",
      "assign": { "paradigm": { "preclinical": 0.8, "animal_model": 0.8 }, "unit": { "L2": 0.9 }, "design": { "animal_in_vivo": 0.9, "perturbation": 0.6 }, "materials": { "animal_mouse": 0.9 } } },
    { "id": "mesh_xenograft", "source": "pubmed", "when": { "mesh_any": ["Xenograft Model Antitumor Assays"] },
      "assign": { "design": { "xenograft_pdx": 0.9 } } },
    { "id": "mesh_preclinical_drug", "source": "pubmed", "when": { "mesh_any": ["Drug Evaluation, Preclinical"] }, "ui_hint": "D004355",
      "assign": { "paradigm": { "preclinical": 0.9 }, "objective": { "therapeutic_development": 0.7 } } },
    { "id": "mesh_cell_culture", "source": "pubmed", "when": { "mesh_any": ["Cell Line", "Cells, Cultured", "Organoids", "Cell Line, Tumor"], "not": { "pubtype_any": ["Randomized Controlled Trial", "Observational Study"] } }, "ui_hint": "D002460 · D002478 · D000072902",
      "assign": { "paradigm": { "molecular_cellular_mechanistic": 0.8, "basic_discovery": 0.5 }, "unit": { "L1": 0.9 }, "design": { "wet_lab_experiment": 0.9 }, "materials": { "cell_lines": 0.8, "organoids_ipsc": 0.3 } } },
    { "id": "mesh_mechanism", "source": "pubmed", "when": { "mesh_any": ["Signal Transduction", "Gene Expression Regulation", "CRISPR-Cas Systems", "Gene Knockdown Techniques", "RNA Interference", "Protein Binding"] }, "ui_hint": "D015398 · D005786 · D064113 · D055785",
      "assign": { "paradigm": { "molecular_cellular_mechanistic": 0.85 }, "unit": { "L1": 0.9 }, "design": { "perturbation": 0.7, "wet_lab_experiment": 0.6 }, "objective": { "mechanism_discovery": 0.7 } } },
    { "id": "mesh_structural", "source": "pubmed", "when": { "mesh_any": ["Crystallography, X-Ray", "Cryoelectron Microscopy", "Protein Conformation"] },
      "assign": { "paradigm": { "basic_discovery": 0.8 }, "unit": { "L1": 0.95 }, "design": { "biochemical_structural": 0.9 } } },
    { "id": "mesh_omics_methods", "source": "pubmed", "when": { "mesh_any": ["Single-Cell Analysis", "Sequence Analysis, RNA", "Proteomics", "Metabolomics", "Gene Expression Profiling", "High-Throughput Nucleotide Sequencing"] }, "ui_hint": "D059010 · D017423 · D040901 · D055432",
      "assign": { "unit": { "L1": 0.7 }, "design": { "single_cell": 0.5, "bulk_omics": 0.5, "proteomics_metabolomics": 0.4 } } },
    { "id": "mesh_single_cell", "source": "pubmed", "when": { "mesh_any": ["Single-Cell Analysis", "Single-Cell Gene Expression Analysis"] },
      "assign": { "design": { "single_cell": 0.9 } } },
    { "id": "mesh_imaging", "source": "pubmed", "when": { "mesh_any": ["Microscopy, Fluorescence", "Intravital Microscopy", "Magnetic Resonance Imaging", "Positron-Emission Tomography", "Image Processing, Computer-Assisted"] },
      "assign": { "design": { "spatial_imaging": 0.7 } } },
    { "id": "human_biospecimen", "source": "pubmed", "when": { "check_tag": ["Humans"], "mesh_any": ["Biopsy", "Biomarkers", "Specimen Handling", "Primary Cell Culture", "Leukocytes, Mononuclear", "Biological Specimen Banks"], "not": { "pubtype_any": ["Randomized Controlled Trial", "Clinical Trial", "Observational Study"], "mesh_any": ["Cohort Studies", "Case-Control Studies", "Cross-Sectional Studies"] } }, "ui_hint": "D006801 · D001706 · D015415 · D013048 · D061251",
      "assign": { "paradigm": { "human_biospecimen": 0.8, "translational": 0.5 }, "unit": { "L1": 0.6, "L3": 0.7 }, "design": { "biospecimen_assay": 0.85, "wet_lab_experiment": 0.4 }, "materials": { "human_tissue_biopsy": 0.5, "human_blood_fluids": 0.5 } } },
    { "id": "triangle_animal_human", "source": "pubmed", "when": { "triangle_class_any": ["AH", "CH", "ACH"] },
      "assign": { "paradigm": { "translational": 0.7 } } },
    { "id": "mesh_treatment_outcome_human", "source": "pubmed", "when": { "check_tag": ["Humans"], "mesh_any": ["Treatment Outcome"], "not": { "pubtype_any": ["Randomized Controlled Trial", "Clinical Trial"] } }, "ui_hint": "D016896",
      "assign": { "paradigm": { "clinical_observational": 0.5, "interventional_clinical": 0.4 }, "unit": { "L3": 0.7 }, "objective": { "treatment_evaluation_efficacy": 0.6 } } },

    { "id": "ctgov_interventional_pi", "source": "ctgov", "when": { "study_type": "INTERVENTIONAL", "investigator_role_any": ["PRINCIPAL_INVESTIGATOR", "STUDY_CHAIR", "STUDY_DIRECTOR", "RESPONSIBLE_PARTY_PI"] },
      "assign": { "paradigm": { "clinical_trials": 0.95 }, "unit": { "L3": 0.95 }, "design": { "rct": 0.7, "early_phase_trial": 0.4 }, "materials": { "enrolled_participants": 0.95 } },
      "refine": { "phases_any": { "EARLY_PHASE1": { "design": { "early_phase_trial": 0.95, "rct": 0.2 }, "paradigm": { "early_phase_human_experimental": 0.7 } }, "PHASE1": { "design": { "early_phase_trial": 0.9, "rct": 0.3 } }, "PHASE2": { "design": { "rct": 0.8 } }, "PHASE3": { "design": { "rct": 0.95 } }, "PHASE4": { "design": { "pragmatic_trial": 0.5, "rct": 0.7 } } } } },
    { "id": "ctgov_interventional_listed", "source": "ctgov", "when": { "study_type": "INTERVENTIONAL", "not": { "investigator_role_any": ["PRINCIPAL_INVESTIGATOR", "STUDY_CHAIR", "STUDY_DIRECTOR", "RESPONSIBLE_PARTY_PI"] } },
      "assign": { "paradigm": { "clinical_trials": 0.5 }, "unit": { "L3": 0.8 }, "design": { "rct": 0.4 }, "materials": { "enrolled_participants": 0.7 } } },
    { "id": "ctgov_hsr_purpose", "source": "ctgov", "when": { "primary_purpose": "HEALTH_SERVICES_RESEARCH" },
      "assign": { "paradigm": { "health_services": 0.8, "implementation_science": 0.4 }, "unit": { "L5": 0.6 }, "design": { "pragmatic_trial": 0.6 } } },
    { "id": "ctgov_basic_science_purpose", "source": "ctgov", "when": { "study_type": "INTERVENTIONAL", "primary_purpose": "BASIC_SCIENCE" },
      "assign": { "paradigm": { "early_phase_human_experimental": 0.9 }, "unit": { "L3": 0.9 }, "design": { "early_phase_trial": 0.7 } } },
    { "id": "ctgov_observational_cohort_large", "source": "ctgov", "when": { "study_type": "OBSERVATIONAL", "observational_model": "COHORT", "enrollment_min": 1000 },
      "assign": { "paradigm": { "epidemiology": 0.6, "clinical_observational": 0.5 }, "unit": { "L4": 0.8 }, "design": { "prospective_cohort": 0.9 }, "materials": { "cohort_biobank_datasets": 0.7 } } },
    { "id": "ctgov_observational_other", "source": "ctgov", "when": { "study_type": "OBSERVATIONAL", "not": { "enrollment_min": 1000 } },
      "assign": { "paradigm": { "clinical_observational": 0.7 }, "unit": { "L3": 0.8 }, "design": { "prospective_cohort": 0.6 }, "materials": { "enrolled_participants": 0.7 } } },
    { "id": "ctgov_behavioral_intervention", "source": "ctgov", "when": { "intervention_types_any": ["BEHAVIORAL"] },
      "assign": { "paradigm": { "behavioral": 0.7 } } },

    { "id": "reporter_k23_k24", "source": "reporter", "when": { "activity_code_any": ["K23", "K24"] },
      "assign": { "paradigm": { "clinical_observational": 0.7, "clinical_trials": 0.6 }, "unit": { "L3": 0.8 }, "materials": { "enrolled_participants": 0.8 } } },
    { "id": "reporter_k08", "source": "reporter", "when": { "activity_code_any": ["K08"] },
      "assign": { "paradigm": { "molecular_cellular_mechanistic": 0.6, "translational": 0.6 }, "unit": { "L1": 0.6 }, "design": { "wet_lab_experiment": 0.7 } } },
    { "id": "reporter_trial_mechanisms", "source": "reporter", "when": { "activity_code_any": ["UG3", "UH3", "UM1", "R34", "U10", "UG1"] },
      "assign": { "paradigm": { "clinical_trials": 0.8 }, "unit": { "L3": 0.8 }, "design": { "rct": 0.8 } } },
    { "id": "reporter_r18", "source": "reporter", "when": { "activity_code_any": ["R18"] },
      "assign": { "paradigm": { "implementation_science": 0.7, "health_services": 0.6 }, "unit": { "L5": 0.7 }, "design": { "hybrid_effectiveness_implementation": 0.5, "implementation_evaluation": 0.5 } } },
    { "id": "reporter_rcdc_clinical_trials", "source": "reporter", "when": { "rcdc_any": ["Clinical Trials"] }, "assign": { "paradigm": { "clinical_trials": 0.7 } } },
    { "id": "reporter_rcdc_clinical_research", "source": "reporter", "when": { "rcdc_any": ["Clinical Research"] }, "assign": { "paradigm": { "clinical_observational": 0.5, "clinical_trials": 0.3, "human_biospecimen": 0.3 } } },
    { "id": "reporter_rcdc_hsr", "source": "reporter", "when": { "rcdc_any": ["Health Services"] }, "assign": { "paradigm": { "health_services": 0.7 } } },
    { "id": "reporter_rcdc_cer", "source": "reporter", "when": { "rcdc_any": ["Comparative Effectiveness Research"] }, "assign": { "paradigm": { "comparative_effectiveness": 0.7 } } },
    { "id": "reporter_rcdc_prevention", "source": "reporter", "when": { "rcdc_any": ["Prevention"] }, "assign": { "objective": { "prevention": 0.7 } } },
    { "id": "reporter_rcdc_behavioral", "source": "reporter", "when": { "rcdc_any": ["Behavioral and Social Science", "Basic Behavioral and Social Science"] }, "assign": { "paradigm": { "behavioral": 0.6 } } },
    { "id": "reporter_rcdc_epi", "source": "reporter", "when": { "rcdc_any": ["Epidemiology and Longitudinal Studies"] }, "_verify_name": true, "assign": { "paradigm": { "epidemiology": 0.7 } } },
    { "id": "reporter_rcdc_di", "source": "reporter", "when": { "rcdc_any": ["Dissemination and Implementation Research"] }, "_verify_name": true, "assign": { "paradigm": { "implementation_science": 0.7 } } },
    { "id": "reporter_rcdc_translational", "source": "reporter", "when": { "rcdc_any": ["Translational Research"] }, "_verify_name": true, "assign": { "paradigm": { "translational": 0.5 } } },
    { "id": "reporter_study_section_family", "source": "reporter", "when": { "study_section_family_table": "src/lib/fit/study-sections.json" }, "assign_from_table": true,
      "_comment": "Curated IRG/study-section → family prior (0.6). Build the table in PR 1.2 from the study sections actually present in investigator_nih_grants; do not enumerate all of CSR." },

    { "id": "notice_ct_required", "source": "notice", "when": { "clinical_trial_designation": "required" }, "assign_notice": "taxonomy.opportunity_profile.clinical_trial_designation.required" },
    { "id": "notice_besh_required", "source": "notice", "when": { "clinical_trial_designation": "besh_required" }, "assign_notice": "taxonomy.opportunity_profile.clinical_trial_designation.besh_required" },
    { "id": "notice_ct_not_allowed", "source": "notice", "when": { "clinical_trial_designation": "not_allowed" }, "assign_notice": "taxonomy.opportunity_profile.clinical_trial_designation.not_allowed" },
    { "id": "notice_activity_code", "source": "notice", "when": { "activity_code_present": true }, "assign_notice": "taxonomy.opportunity_profile.activity_code_priors[activity_code]" },
    { "id": "notice_program_division", "source": "notice", "when": { "program_division_table": "src/lib/fit/program-divisions.json" }, "assign_from_table": true,
      "_comment": "Curated IC division → family prior (0.5). Seed with the divisions that appear in the open-notice corpus (Section VII Scientific/Research Contact)." },

    { "id": "profiles_clinical_series", "source": "profiles", "when": { "title_series_any": ["Clinical X", "Health Sciences Clinical"] }, "assign": { "paradigm": { "clinical_observational": 0.3 } }, "_comment": "Weak prior only — most UCSF physician-scientists hold In Residence titles (intake CSV: 62 In Residence, 43 Ladder Rank, 6 clinical series)." },
    { "id": "directory_epi_dept", "source": "directory", "when": { "department_match": "Epidemiology" }, "assign": { "paradigm": { "epidemiology": 0.5, "population_health": 0.4 }, "unit": { "L4": 0.4 } } },
